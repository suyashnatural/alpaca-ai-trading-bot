# ============================================================
# ALPACA TRADING BOT - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in your actual values
# NEVER commit your .env file to GitHub!
# ============================================================

# --- Alpaca API Credentials ---
ALPACA_API_KEY=your_api_key_here
ALPACA_SECRET_KEY=your_secret_key_here

# Set to "true" for paper trading, "false" for live trading
ALPACA_PAPER=true

# --- Amazon Bedrock (Claude Opus) ---
# Get these from AWS Console → IAM → Your User → Security Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-opus-4-5

# --- Email Notifications (Gmail recommended) ---
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here
EMAIL_RECEIVER=your_email@gmail.com

# --- Bot Configuration ---
# Total weekly budget in USD
WEEKLY_BUDGET=750

# Stop loss percentage (e.g. 20 = sell if stock drops 20%)
STOP_LOSS_PCT=20

# Take profit percentage (e.g. 40 = sell half if stock rises 40%)
TAKE_PROFIT_PCT=40

# Day of week to run weekly buys (0=Mon, 1=Tue, ..., 4=Fri)
BUY_DAY_OF_WEEK=0

# Time to run daily analysis (24hr format, market timezone ET)
DAILY_ANALYSIS_TIME=09:30

# Time to run stop-loss/take-profit checks
RISK_CHECK_TIME=15:45

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
